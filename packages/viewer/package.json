{
  "name": "@elevation/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "Elevation viewer: a 3D sketch-style view of a code change.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
